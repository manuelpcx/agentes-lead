// Esquema Prisma — Fase 1 (cimientos).
// Solo las 5 entidades de esta fase. pgvector queda habilitado desde ya
// (aunque no se use hasta Fase 2) para no re-tocar la extensión después.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─────────────────────────── Enums ───────────────────────────

enum AgentType {
  VENTAS
  SOPORTE
  COBRANZA
  AGENDAMIENTO
  CUSTOM
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  EN_CONVERSACION
  AGENDADO
  CERRADO_GANADO
  CERRADO_PERDIDO
  ESCALADO_HUMANO
}

/// Calificación explícita del lead (interés/urgencia real), a diferencia de
/// `LeadStatus` que es la etapa del embudo. Nula hasta que el agente tenga
/// señales suficientes para calificarlo.
enum LeadQualification {
  FRIO
  TIBIO
  CALIENTE
}

enum Channel {
  whatsapp
  email
  call
  system
}

enum Direction {
  inbound
  outbound
}

enum KnowledgeSourceType {
  manual
  archivo
  faq
}

enum FactCategory {
  PRECIO
  SERVICIO
  HORARIO
  POLITICA
  OTRO
}

/// Roles del panel dentro de una empresa.
enum PanelRole {
  OWNER
  OPERADOR
  SOLO_LECTURA
}

/// Estado de una cita agendada.
enum AppointmentStatus {
  PROGRAMADA
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

/// Estado de un vacío de conocimiento en la cola de aprobación.
enum KnowledgeGapStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

/// Estado de una falla de cumplimiento en la cola de aprobación.
enum ComplianceIssueStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─────────────────────────── Modelos ───────────────────────────

/// Raíz del multi-tenancy. Toda entidad de negocio cuelga de aquí.
model Company {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  rut               String
  timezone          String   @default("America/Santiago")
  businessHours     Json     @default("{}")
  channelsConfig    Json     @default("{}")
  /// Secreto para verificar la firma HMAC del webhook. Cifrado en reposo (app-layer).
  webhookSecret     String
  isActive          Boolean  @default(true)
  /// Tope mensual de minutos de voz gestionada (la cuenta de la plataforma).
  /// Null = el valor por defecto (VOICE_MONTHLY_MINUTES_DEFAULT). Solo lo
  /// cambia la plataforma: no va en channelsConfig, que edita la empresa.
  voiceMinutesLimit Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agents                Agent[]
  leads                 Lead[]
  interactions          Interaction[]
  conversations         Conversation[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeChunks       KnowledgeChunk[]
  structuredFacts       StructuredFact[]
  promptVersions        PromptVersion[]
  memberships           Membership[]
  agentActions          AgentAction[]
  auditLogs             AuditLog[]
  appointments          Appointment[]
  knowledgeGaps         KnowledgeGap[]
  complianceIssues      ComplianceIssue[]
  examples              ExampleLibrary[]
  metrics               AgentMetric[]
  integrations          Integration[]
  leadNotes             LeadNote[]
  leadMemories          LeadMemory[]
  interactionEmbeddings InteractionEmbedding[]
  apiKeys               ApiKey[]
  emailDomain           EmailDomain?
  voiceCalls            VoiceCall[]
  providerIncidents     ProviderIncident[]

  @@index([isActive])
}

// Cada llamada de voz iniciada: base del tope mensual de minutos y del límite
// de llamadas simultáneas de la voz gestionada, y de la correlación del
// webhook de fin de llamada. Tenant-scoped por `companyId`.
model VoiceCall {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  leadId       String    @db.Uuid
  /// elevenlabs | retell | vapi
  provider     String
  /// Salió por la cuenta de la plataforma (voz gestionada): cuenta para el tope.
  managed      Boolean   @default(false)
  /// Id de la llamada en el proveedor (`conversation_id` en ElevenLabs).
  callId       String
  /// started | completed | failed
  status       String    @default("started")
  durationSecs Int?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([provider, callId])
  @@index([companyId, startedAt])
}

// Dominio propio de una empresa para enviar correo con la cuenta de Resend de
// la PLATAFORMA (correo gestionado): la empresa solo crea los registros DNS.
// Uno por empresa. Tenant-scoped por `companyId`.
model EmailDomain {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @unique @db.Uuid
  /// En minúsculas, p. ej. notificaciones.cliente.cl.
  domain         String    @unique
  resendDomainId String    @unique
  /// Estado según Resend: not_started, pending, verified, partially_verified,
  /// partially_failed, failed o temporary_failure.
  status         String
  /// Registros DNS que tiene que crear la empresa, tal como los entrega Resend.
  records        Json      @default("[]")
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Credenciales de proveedores por empresa (BYO: cada empresa trae su propia
// cuenta de WhatsApp/correo/voz). El secreto (API key/token) va cifrado en
// reposo (app-layer, CryptoService). Tenant-scoped por `companyId`.
model Integration {
  id               String  @id @default(uuid()) @db.Uuid
  companyId        String  @db.Uuid
  /// Canal: 'whatsapp' | 'email' | 'voice'.
  channel          String
  /// Proveedor: 'ycloud' | 'meta' | 'resend' | 'retell'.
  provider         String
  /// Datos NO secretos del proveedor (from, wabaId, agentId, etc.).
  config           Json    @default("{}")
  /// Secreto (API key/token) cifrado con CryptoService. Nunca se expone.
  secretEnc        String?
  /// Secreto de firma de webhooks (distinto de secretEnc en proveedores que lo
  /// separan, p. ej. YCloud), cifrado con CryptoService. Nunca se expone.
  webhookSecretEnc String?
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, channel])
  @@index([companyId])
}

/// Llave de API por empresa. La usa el servidor MCP (y cualquier integración
/// que necesite entrar sin un usuario humano detrás). Se guarda solo el hash:
/// la llave en claro se muestra UNA vez, al crearla.
model ApiKey {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// Nombre para reconocerla en el panel ("Claude de escritorio", "n8n").
  name   String
  /// Primeros caracteres de la llave, para identificarla sin revelarla.
  prefix String
  /// SHA-256 de la llave completa. Nunca guardamos la llave en claro.
  hash   String @unique

  /// Permisos de la llave. Por defecto solo lectura.
  role PanelRole @default(SOLO_LECTURA)

  /// Usuario que la emitió: queda como responsable de lo que la llave haga.
  createdById String? @db.Uuid

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Agente especializado dentro de una empresa. Existe desde Fase 1, pero el
/// enrutamiento/traspaso entre agentes NO se implementa hasta Fase 8.
model Agent {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  name           String
  type           AgentType @default(VENTAS)
  description    String?
  /// Identificadores de herramientas habilitadas para este agente.
  enabledTools   String[]  @default([])
  /// Qué documentos y categorías de StructuredFact puede consultar (Fase 2+).
  knowledgeScope Json      @default("{}")
  /// Config de seguimiento propia del agente: escalera de canales, espaciado,
  /// tope de intentos, retardo de primer contacto y plantillas de WhatsApp por
  /// propósito (apertura/seguimiento/reactivación). Lo no definido cae a los
  /// defaults globales. Ver `agents/followup-config.ts`.
  followupConfig Json      @default("{}")
  /// Enrutamiento por canal: canales que este agente atiende ([] = cualquiera).
  channels       String[]  @default([])
  /// Enrutamiento por estado del lead: estados que maneja ([] = cualquiera).
  /// Se guardan como texto para no acoplar el routing al enum LeadStatus.
  leadStates     String[]  @default([])
  /// Desempate cuando varios agentes son candidatos (mayor gana). Fase 8.
  priority       Int       @default(0)
  /// Agente por defecto/fallback de la empresa: recibe lo no clasificado.
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads            Lead[]
  interactions     Interaction[]
  conversations    Conversation[]
  promptVersions   PromptVersion[]
  complianceIssues ComplianceIssue[]

  @@index([companyId, isActive])
}

/// Lead capturado. `externalId` da idempotencia por empresa.
model Lead {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @db.Uuid
  /// Agente actualmente a cargo del lead.
  agentId    String @db.Uuid
  externalId String

  name  String?
  /// Teléfono en formato E.164 (contexto Chile +56).
  phone String?
  email String?

  source   String?
  campaign String?
  metadata Json    @default("{}")

  status LeadStatus @default(NUEVO)

  /// Calificación de interés/urgencia real, distinta del estado del embudo.
  /// Nula hasta que el agente tenga señales suficientes (ver tool `calificarLead`).
  qualification       LeadQualification?
  /// Motivo breve de la calificación actual, para transparencia y auditoría.
  qualificationReason String?
  qualifiedAt         DateTime?

  nextActionAt    DateTime?
  nextActionType  String?
  contactAttempts Int       @default(0)
  lastContactedAt DateTime?

  preferredChannel Channel?
  timezone         String?

  /// Si es true, el agente no actúa sobre este lead (control humano).
  isPausedForHuman Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent                 Agent                  @relation(fields: [agentId], references: [id])
  interactions          Interaction[]
  interactionEmbeddings InteractionEmbedding[]
  conversations         Conversation[]
  agentActions          AgentAction[]
  appointments          Appointment[]
  notes                 LeadNote[]
  memory                LeadMemory?
  voiceCalls            VoiceCall[]

  @@unique([companyId, externalId])
  @@index([nextActionAt])
  @@index([companyId, status])
  @@index([agentId, status])
}

/// Cada mensaje / evento sobre un lead. `agentId` es null si lo envió un humano.
model Interaction {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  agentId        String?   @db.Uuid
  leadId         String    @db.Uuid
  conversationId String?   @db.Uuid
  channel        Channel
  direction      Direction
  content        String
  metadata       Json      @default("{}")
  occurredAt     DateTime  @default(now())

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent        Agent?                @relation(fields: [agentId], references: [id])
  lead         Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation?         @relation(fields: [conversationId], references: [id])
  embedding    InteractionEmbedding?

  @@index([companyId, leadId])
  @@index([leadId, occurredAt])
}

/// Embedding de una interacción de conversación, para recuperar mensajes
/// antiguos por relevancia cuando ya salieron de la ventana de historial.
/// El vector se escribe y se lee solo por SQL crudo (pgvector), siempre con
/// `companyId` explícito. Sin índice vectorial: la búsqueda es siempre dentro
/// de UN lead (cientos de filas a lo más), y el índice por lead basta.
model InteractionEmbedding {
  id             String                      @id @default(uuid()) @db.Uuid
  companyId      String                      @db.Uuid
  leadId         String                      @db.Uuid
  interactionId  String                      @unique @db.Uuid
  embedding      Unsupported("vector(1024)")
  /// Qué modelo produjo el vector (`local:1024`, `voyage:voyage-3.5:1024`).
  embeddingModel String
  createdAt      DateTime                    @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([companyId, leadId])
  @@index([embeddingModel])
}

/// Agrupa interacciones de una misma sesión. `analyzedAt` queda null hasta
/// que el batch de mejora continua (Fase 6) la procese.
model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  agentId    String    @db.Uuid
  leadId     String    @db.Uuid
  channel    Channel
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  outcome    String?
  analyzedAt DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent        Agent         @relation(fields: [agentId], references: [id])
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([companyId, leadId])
  @@index([analyzedAt])
}

// ─────────────────────── Base de conocimiento (Fase 2) ───────────────────────

/// Documento fuente que se trocea e indexa para RAG.
model KnowledgeDocument {
  id         String              @id @default(uuid()) @db.Uuid
  companyId  String              @db.Uuid
  title      String
  sourceType KnowledgeSourceType @default(manual)
  rawContent String
  /// Contador simple de versión; se incrementa en cada edición.
  version    Int                 @default(1)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]

  @@index([companyId, isActive])
}

/// Fragmento de un documento con su embedding (pgvector). La columna `embedding`
/// es `Unsupported`: se inserta y se consulta por SQL crudo (Prisma no maneja el
/// tipo `vector`). El índice HNSW se crea en la migración.
model KnowledgeChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  companyId      String                      @db.Uuid
  documentId     String                      @db.Uuid
  content        String
  embedding      Unsupported("vector(1024)")
  /// Qué modelo produjo el vector; solo se busca entre los del modelo activo.
  embeddingModel String
  chunkIndex     Int
  metadata       Json                        @default("{}")
  createdAt      DateTime                    @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([documentId])
  @@index([embeddingModel])
}

/// Usuario del panel (auth-plane, transversal a empresas).
model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique
  passwordHash           String
  name                   String?
  isActive               Boolean   @default(true)
  /// Última vez que cambió la contraseña: los JWT emitidos antes dejan de valer.
  passwordChangedAt      DateTime?
  /// Administrador de la PLATAFORMA (nosotros), no de una empresa. Ve el
  /// listado de clientes y crea cuentas de demo. Cruza el aislamiento
  /// multi-tenant a propósito, así que se marca a mano por SQL.
  isPlatformAdmin        Boolean   @default(false)
  /// Cuándo terminó (o saltó) el tour de bienvenida. Null = nunca lo vio.
  /// Va en el usuario y no en el navegador: quien ya lo hizo no debería
  /// verlo otra vez por entrar desde otro equipo.
  onboardingCompletedAt  DateTime?
  /// Huella SHA-256 del token de recuperación vigente (el token va por correo).
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships Membership[]
}

/// Acceso de un usuario a una empresa, con su rol. Una cuenta puede tener
/// varias membresías (acceso a varias empresas).
model Membership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  companyId String    @db.Uuid
  role      PanelRole @default(OPERADOR)
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Registro de cada acción/herramienta que ejecutó el agente (para depurar y
/// dar confianza en el panel): qué usó, con qué parámetros y qué devolvió.
model AgentAction {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  agentId        String   @db.Uuid
  leadId         String   @db.Uuid
  conversationId String?  @db.Uuid
  tool           String
  input          Json     @default("{}")
  output         String
  isError        Boolean  @default(false)
  occurredAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, leadId, occurredAt])
}

/// Log de auditoría de cambios sensibles hechos desde el panel.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  userId        String?  @db.Uuid
  action        String
  entity        String
  entityId      String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

/// Vacío de conocimiento detectado por el análisis (Fase 6). Se agrupa por
/// pregunta y se cuenta la frecuencia; nada entra a la base sin aprobación.
model KnowledgeGap {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @db.Uuid
  conversationId   String?            @db.Uuid
  question         String
  suggestedAnswer  String?
  frequency        Int                @default(1)
  status           KnowledgeGapStatus @default(PENDIENTE)
  resolvedByUserId String?            @db.Uuid
  resolvedAt       DateTime?
  detectedAt       DateTime           @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, frequency])
}

/// Falla de cumplimiento detectada en una conversación real: el agente no
/// respetó una de SUS PROPIAS reglas (las de su prompt activo — por eso es
/// distinto por agente/tipo, a diferencia de los vacíos de conocimiento que
/// son a nivel empresa). Ej.: ignoró un "no me llames", repitió una acción ya
/// hecha, no usó la herramienta que correspondía.
model ComplianceIssue {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @db.Uuid
  agentId          String                @db.Uuid
  conversationId   String?               @db.Uuid
  /// Regla incumplida, en una frase (ej. "Siguió ofreciendo llamar después de que el cliente pidió que no lo llamaran").
  issue            String
  /// Cita textual del agente en la transcripción que evidencia la falla.
  evidence         String?
  frequency        Int                   @default(1)
  status           ComplianceIssueStatus @default(PENDIENTE)
  resolvedByUserId String?               @db.Uuid
  resolvedAt       DateTime?
  detectedAt       DateTime              @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([companyId, agentId, status, frequency])
}

/// Biblioteca de ejemplos de buenas respuestas (Fase 6). Con embedding para
/// recuperar los más similares e inyectarlos como few-shot en tiempo de ejecución.
model ExampleLibrary {
  id             String                      @id @default(uuid()) @db.Uuid
  companyId      String                      @db.Uuid
  situation      String
  agentResponse  String
  outcome        String
  embedding      Unsupported("vector(1024)")
  /// Qué modelo produjo el vector; solo se busca entre los del modelo activo.
  embeddingModel String
  isApproved     Boolean                     @default(false)
  usageCount     Int                         @default(0)
  createdAt      DateTime                    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isApproved])
  @@index([embeddingModel])
}

/// Métrica agregada por empresa/día (Fase 6).
model AgentMetric {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  agentId    String?  @db.Uuid
  date       DateTime @db.Date
  metricType String
  value      Float
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, metricType, date])
  @@index([companyId, date])
}

/// Cita agendada con un lead (Fase 5).
model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @db.Uuid
  leadId         String            @db.Uuid
  agentId        String?           @db.Uuid
  title          String
  startAt        DateTime
  endAt          DateTime
  location       String?
  status         AppointmentStatus @default(PROGRAMADA)
  notes          String?
  /// Instante en que se envió el recordatorio previo (null si aún no).
  reminderSentAt DateTime?
  createdBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, startAt])
  @@index([reminderSentAt, startAt])
}

/// Nota interna que un humano deja sobre un lead (CRM propio del panel).
/// No entra al contexto del agente: es memoria del equipo, no del modelo.
/// Memoria viva de un lead: lo que el agente sabe de esa persona mas alla de
/// la ventana de mensajes reciente. Va en su propia tabla, separada de
/// `Lead.metadata` (que es de la ingesta y la pisan las sincronizaciones del
/// CRM) y NO cuenta como respaldo del guardrail de cifras: es contexto que el
/// agente dedujo de la conversacion, no un dato verificado.
model LeadMemory {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  leadId    String @unique @db.Uuid

  /// Resumen en prosa de quien es el lead y en que quedo la relacion.
  summary        String?
  /// `occurredAt` de la interaccion mas nueva incluida en el resumen.
  summarizedUpto DateTime?
  /// Hechos clave como lista de `{ clave, valor, importancia, registradoEn }`.
  facts          Json      @default("[]")
  /// Conclusiones (reflexiones) como lista de `{ texto, evidencia, creadaEn }`;
  /// `evidencia` son ids de las interacciones que respaldan cada una.
  insights       Json      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, leadId])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  leadId    String   @db.Uuid
  /// Usuario del panel que la escribió (null si la borraron de Membership).
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId, leadId, createdAt])
}

/// System prompt versionado por agente. Solo una versión activa por agente.
/// La gestión/aprobación de versiones se completa en Fase 6; en Fase 3 se
/// siembra una versión activa por defecto al crear el agente.
model PromptVersion {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  agentId      String   @db.Uuid
  version      Int
  content      String
  changeReason String?
  isActive     Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([companyId, agentId, isActive])
}

/// Datos vivos que NO van a RAG sino a consulta directa (precios, horarios,
/// políticas...). Fuente de verdad; respeta vigencia por fecha.
model StructuredFact {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  key        String
  category   FactCategory
  value      Json
  validFrom  DateTime     @default(now())
  validUntil DateTime?
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, key, isActive])
  @@index([companyId, category])
}

/// Incidente de un proveedor externo (WhatsApp, correo, voz, IA): se abre
/// cuando los envíos por una cuenta empiezan a fallar y se cierra con el
/// primer envío exitoso. Ver `src/alerts/`.
model ProviderIncident {
  id                 String    @id @default(uuid()) @db.Uuid
  /// Empresa dueña de la cuenta; null = cuenta de la plataforma.
  companyId          String?   @db.Uuid
  scope              String
  service            String
  provider           String
  kind               String
  reason             String
  hint               String?
  failureCount       Int       @default(1)
  /// Empresas que sufrieron el incidente (relevante en los de plataforma).
  affectedCompanyIds String[]  @db.Uuid
  openedAt           DateTime  @default(now())
  lastFailureAt      DateTime  @default(now())
  resolvedAt         DateTime?
  openNotifiedAt     DateTime?
  /// Clave permanente (empresa o plataforma + canal + proveedor).
  key                String
  /// Copia de `key` mientras está abierto; null al cerrarse. Único: un solo
  /// incidente abierto por clave (Postgres permite varios NULL).
  openKey            String?   @unique

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, resolvedAt])
  @@index([resolvedAt])
  @@index([key, openedAt])
}

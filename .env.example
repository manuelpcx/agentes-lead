# ─────────────────────────────────────────────────────────────
# Configuración de entorno — copia este archivo a `.env`
# El arranque hace fail-fast si falta cualquier variable requerida.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Orígenes permitidos por CORS (coma-separados). Vacío = cualquiera (dev).
# En producción: el dominio del panel, ej. https://tu-panel.vercel.app
CORS_ORIGIN=
# URL pública del panel (para los enlaces de "recuperar contraseña"). Si falta,
# se usa el primer origen de CORS_ORIGIN.
PANEL_URL=
# URL pública de este backend, la que el panel muestra como webhook en
# Integraciones (ej. https://api.tu-dominio.cl). Si falta, se deduce de la
# petición del panel.
PUBLIC_API_URL=

# ── PostgreSQL (con extensión pgvector) ──
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://agentes:agentes@localhost:5432/agentes_lead?schema=public

# ── Redis (colas BullMQ) ──
# El docker-compose publica Redis en el host 6380 (evita chocar con un Redis
# ya corriendo en 6379). Si usas tu propio Redis en 6379, cámbialo aquí.
REDIS_URL=redis://localhost:6380

# ── Cifrado en reposo de credenciales (AES-256-GCM) ──
# DEBE ser exactamente 32 bytes en hex (64 caracteres hex) o base64 de 32 bytes.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REEMPLAZAR_POR_CLAVE_DE_32_BYTES_EN_HEX

# ── Nivel de log (pino): fatal | error | warn | info | debug | trace ──
LOG_LEVEL=info

# ── Embeddings (base de conocimiento, Fase 2) ──
# 'local' = embedder determinista sin API key (ideal para desarrollo).
# 'voyage' = Voyage AI (requiere VOYAGE_API_KEY).
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=voyage-3.5
# Debe coincidir con la dimensión de la columna vector en la BD (1024).
EMBEDDINGS_DIMENSION=1024
# Solo necesaria si EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=
# Similitud mínima de la base de conocimiento y de los mensajes viejos.
# Vacías = las del proveedor (local 0.3 / 0.3, Voyage 0.55 / 0.3).
# Calíbralas con `npm run embeddings:calibrar`.
EMBEDDINGS_MIN_SIMILARITY=
EMBEDDINGS_RECALL_MIN_SIMILARITY=

# ── Agente / LLM (Fase 3) ──
# Sin ANTHROPIC_API_KEY el agente degrada a escalamiento (no rompe el pipeline).
ANTHROPIC_API_KEY=
# sonnet-5 por defecto; 'claude-sonnet-5' es más barato para alto volumen.
ANTHROPIC_MODEL=claude-sonnet-5
# Modelo para tareas de fondo simples y de mucho volumen (resumen de la memoria
# del lead, elegir agente). Vacío = el mismo ANTHROPIC_MODEL. Usa uno que acepte
# `effort`, p. ej. claude-haiku-5-5 (Haiku 4.5 no lo acepta). El análisis
# nocturno, el playbook y la conversación siguen en ANTHROPIC_MODEL.
ANTHROPIC_BACKGROUND_MODEL=
# Cómo se asegura que el agente responda: 'any' fuerza alguna herramienta
# mientras no haya respondido; 'auto' deja elegir al modelo y le recuerda una
# vez si cierra en texto. Sonnet 5.5, Opus 5.5 y Fable 5.1 EXIGEN 'auto': con
# 'any' responden 400 en cada turno.
ANTHROPIC_TOOL_CHOICE=any
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4096
# Guardas del bucle de decisión.
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_MS=60000
# Ventana de agrupacion de mensajes entrantes (ms): el agente espera este
# tiempo antes de responder, para contestar de una sola vez a las rafagas
# de mensajes seguidos. 0 = responder a cada mensaje por separado.
AGENT_TURN_DEBOUNCE_MS=8000

# ── WhatsApp (Fase 3) ──
# 'log' = consola (dev). 'meta' = WhatsApp Cloud API directo. 'ycloud' = BSP YCloud.
WHATSAPP_PROVIDER=log
# Meta directo:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# YCloud (si WHATSAPP_PROVIDER=ycloud): API key + número de negocio E.164.
YCLOUD_API_KEY=
YCLOUD_FROM=
# WhatsApp Business Account ID en YCloud (para crear/aprobar plantillas desde el
# panel). Del dashboard de YCloud. Sin esto, el panel solo lista, no crea.
YCLOUD_WABA_ID=

# ── Panel / Auth (Fase 7A) ──
# Secreto para firmar los JWT del panel. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REEMPLAZAR_POR_SECRETO_LARGO_DE_AL_MENOS_32_CARACTERES
# Exige X-Timestamp en los webhooks firmados de entrada (ver docs/GUIA_DE_USO.md
# §3.4). Déjalo en false mientras migras tus flujos de n8n; después, true.
WEBHOOK_REQUIRE_TIMESTAMP=false
JWT_EXPIRES_IN=8h

# ── Seguimiento automático (Fase 4) ──
# El cron corre cada 2 min y contacta/persigue leads con nextActionAt vencido.
# Estos valores son los DEFAULTS GLOBALES de la empresa. Cada agente puede
# tener su propia escalera/delays/tope/plantillas en Agent.followupConfig
# (configurable desde el panel, sección "Seguimiento" del agente); lo que un
# agente no defina cae a estos defaults. Ver src/agents/followup-config.ts.
FOLLOWUP_ENABLED=true
FOLLOWUP_MAX_ATTEMPTS=4
FOLLOWUP_BASE_DELAY_HOURS=24
# Espaciado explícito entre intentos, en horas (índice = intento ejecutado).
# Default: 2º toque a 12h, luego 48h y 72h. Vacío = usar BASE_DELAY_HOURS*intento.
FOLLOWUP_DELAYS_HOURS=12,48,72
# Minutos antes del primer contacto de un lead nuevo (0 = casi inmediato).
FOLLOWUP_FIRST_CONTACT_DELAY_MIN=5
# Escalera de canales por intento (coma-separado): email|whatsapp|call.
# Correo primero llega a leads fríos sin plantilla; cicla si hay más intentos.
FOLLOWUP_CHANNEL_LADDER=email,whatsapp,whatsapp,email
# Plantilla (HSM) aprobada para iniciar WhatsApp fuera de la ventana de 24h.
# Vacío = sin plantilla (el agente cae a correo). Debe existir/estar aprobada en
# YCloud/Meta, con DOS variables de cuerpo: {{1}} = nombre del lead, {{2}} =
# nombre de la empresa (tenant). El LANG debe calzar con el idioma de la
# plantilla (p. ej. Spanish (CHL) = es_CL).
FOLLOWUP_WHATSAPP_TEMPLATE=
FOLLOWUP_WHATSAPP_TEMPLATE_LANG=es

# ── Correo (Fase 5) ──
# 'log' = registra el correo en consola (dev). 'smtp' = envío real.
EMAIL_PROVIDER=log
EMAIL_FROM=Agentes Lead <no-reply@agentes-lead.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend (EMAIL_PROVIDER=resend): correos de la plataforma y correo gestionado.
RESEND_API_KEY=

# ── Correo gestionado (las empresas envían por la cuenta de Resend de arriba) ──
# RESEND_API_KEY tiene que tener permiso "Full access" para dar de alta dominios.
# Dominio de la plataforma, verificado en Resend, para enviar mientras la
# empresa verifica el suyo. Vacío = sin dominio propio verificado, no se envía.
EMAIL_SHARED_DOMAIN=
EMAIL_SHARED_LOCAL_PART=notificaciones
# Tope diario (día UTC) de correos por empresa por la cuenta de la plataforma.
EMAIL_DAILY_LIMIT_PER_COMPANY=500
# Región de los dominios nuevos: sa-east-1 (São Paulo), us-east-1, eu-west-1, ap-northeast-1.
RESEND_DOMAIN_REGION=sa-east-1

# ── Voz gestionada (cuentas de Twilio y ElevenLabs de la plataforma) ──
# Las empresas sin cuenta de voz propia llaman por acá. Ver docs/VOZ_GESTIONADA.md.
ELEVENLABS_API_KEY=
# Número de la plataforma importado en ElevenLabs.
ELEVENLABS_PHONE_NUMBER_ID=
# Agente para COBRANZA (si falta, el por defecto) y para el resto de los tipos.
ELEVENLABS_AGENT_ID_COBRANZA=
ELEVENLABS_AGENT_ID_DEFAULT=
# Secreto HMAC del webhook post-llamada → https://TU-BACKEND/voice/elevenlabs/webhook
ELEVENLABS_WEBHOOK_SECRET=
# Minutos al mes por empresa si no tiene otro tope (0 = sin voz hasta asignarle).
VOICE_MONTHLY_MINUTES_DEFAULT=0
# Llamadas simultáneas por empresa.
VOICE_MAX_CONCURRENT_PER_COMPANY=2

# ── Llamadas de voz (Fase 5) ──
# 'log' = stub sin llamada real (dev). 'vapi' = Vapi.ai. 'retell' = Retell AI.
VOICE_PROVIDER=log
# Vapi (si VOICE_PROVIDER=vapi):
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Retell (si VOICE_PROVIDER=retell). Crea el agente con scripts/setup-retell.mjs.
# RETELL_FROM_NUMBER = número de Twilio importado en Retell (E.164).
# Webhook de Retell → https://TU-BACKEND/voice/retell/webhook
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
